<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Loe collects nothing and tracks nobody. Reading data stays on the phone
	     and in the reader's own iCloud. A book's page asks ESTER which libraries
	     have it, sending only the book's record numbers. Search asks Open
	     Library about what the reader typed, and for a book found on Open
	     Library its cover is asked for by cover id or ISBN from Open
	     Library and the Internet Archive, and nothing else. See docs/release.md, "Privacy". -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- The appearance setting and when the catalogue was last checked. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
