    "Books from abroad, and their covers": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välismaal ilmunud raamatud ja nende kaaned"
          }
        }
      }
    },
    "Books published abroad and their covers come from Open Library, an open catalogue run by the Internet Archive.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välismaal ilmunud raamatud ja nende kaaned tulevad Open Libraryst, avatud kataloogist, mida peab Internet Archive."
          }
        }
      }
    },
    "Books published abroad. Loe asks Open Library about what you search for and the books you open from it, and nothing else.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välismaal ilmunud raamatud. Loe küsib Open Libraryst ainult seda, mida sa otsid, ja nende raamatute kohta, mille sealt avad."
          }
        }
      }
    },
