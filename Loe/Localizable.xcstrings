    "Open Settings": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava seaded"
          }
        }
      }
    },
    "Opening a book from abroad asks Open Library what it is about. Open Library sees which book was asked about. An Estonian book's description comes from ESTER along with its cover.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välismaal ilmunud raamatu avamine küsib Open Libraryst, millest see räägib. Open Library näeb, millise raamatu kohta küsiti. Eesti raamatu kirjeldus tuleb ESTERist koos kaanepildiga."
          }
        }
      }
    },
    "Opens in your browser. Choose your libraries and shops in Settings.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaneb brauseris. Oma raamatukogud ja poed saad valida seadetes."
