    "Availability, and the covers and descriptions of Estonian books, come from ESTER, the catalogue Estonian libraries share, run by the ELNET Consortium.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saadavus ning Eesti raamatute kaaned ja kirjeldused tulevad ESTERist, Eesti raamatukogude ühisest kataloogist, mida peab ELNET Konsortsium."
          }
        }
      }
    },
    "Biographical novels": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Biograafilised romaanid"
          }
        }
      }
    },
    "Biographies": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
