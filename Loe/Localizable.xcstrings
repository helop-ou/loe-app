    "Open Library": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Library"
          }
        }
      }
    },
    "Open Library can't be reached right now.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
