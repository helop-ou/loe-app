    "%lld pages": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld page"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld pages"
                }
              }
            }
