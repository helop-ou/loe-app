      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Autor"
          }
        }
      }
    },
    "Books published abroad. Loe asks Open Library about what you search for, and nothing else.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Välismaal ilmunud raamatud. Loe küsib Open Libraryst ainult seda, mida sa otsid."
