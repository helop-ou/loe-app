{
  "sourceLanguage": "en",
  "strings": {
    "%lld editions": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld edition"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld editions"
                }
              }
            }
          }
        },
        "et": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld väljaanne"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld väljaannet"
                }
              }
            }
          }
        }
      }
    },
    "Check the spelling, or try the author's name.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli kirjapilti või proovi autori nime."
          }
        }
      }
    },
    "Check your connection and try again.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli ühendust ja proovi uuesti."
          }
        }
      }
    },
    "Download the catalogue": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadi kataloog alla"
          }
        }
      }
    },
    "Downloading the catalogue": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloog laaditakse alla"
          }
        }
      }
    },
    "Find a book": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia raamat"
          }
        }
      }
    },
    "Find a book in Search and add it to a shelf.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi raamatut ja lisa see riiulisse."
          }
        }
      }
    },
    "It may be from a newer version of Loe.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See võib olla Loe uuemast versioonist."
          }
        }
      }
    },
    "Loe keeps every Estonian book on your phone, so search works offline. It's one download of about 30 MB.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe hoiab kõiki eesti raamatuid sinu telefonis, nii et otsing töötab ka võrguühenduseta. Selleks tuleb üks kord alla laadida umbes 30 MB."
          }
        }
      }
    },
    "No books found": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Raamatuid ei leitud"
          }
        }
      }
    },
    "Nothing to suggest yet": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel pole midagi soovitada"
          }
        }
      }
    },
    "Rate a few books and Loe will suggest what to read next.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinda paari raamatut ja Loe soovitab, mida edasi lugeda."
          }
        }
      }
    },
    "Read next": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe edasi"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi"
          }
        }
      }
    },
    "Search by title, author or ISBN.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi pealkirja, autori või ISBN-i järgi."
          }
        }
      }
    },
    "Shelves": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiulid"
          }
        }
      }
    },
    "The catalogue can't be read": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogi ei saa lugeda"
          }
        }
      }
    },
    "The catalogue isn't here yet": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogi pole veel siin"
          }
        }
      }
    },
    "The download didn't finish": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaadimine jäi pooleli"
          }
        }
      }
    },
    "Title, author or ISBN": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pealkiri, autor või ISBN"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi uuesti"
          }
        }
      }
    },
    "You can keep using Loe while it downloads.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võid Loe kasutamist samal ajal jätkata."
          }
        }
      }
    },
    "Your shelves are empty": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiulid on tühjad"
          }
        }
      }
    }
  },
  "version": "1.0"
}
