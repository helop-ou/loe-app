{
  "sourceLanguage": "en",
  "strings": {
    "%lld editions": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld edition"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld editions"
                }
              }
            }
          }
        },
        "et": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld väljaanne"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld väljaannet"
                }
              }
            }
          }
        }
      }
    },
    "Check the spelling, or try the author's name.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli kirjapilti või proovi autori nime."
          }
        }
      }
    },
    "Find a book": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia raamat"
          }
        }
      }
    },
    "Find a book in Search and add it to a shelf.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi raamatut ja lisa see riiulisse."
          }
        }
      }
    },
    "It may be from a newer version of Loe.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See võib olla Loe uuemast versioonist."
          }
        }
      }
    },
    "Loe keeps every Estonian book on your phone, so search works offline.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe hoiab kõiki eesti raamatuid sinu telefonis, nii et otsing töötab ka võrguühenduseta."
          }
        }
      }
    },
    "No books found": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Raamatuid ei leitud"
          }
        }
      }
    },
    "Nothing to suggest yet": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel pole midagi soovitada"
          }
        }
      }
    },
    "Rate a few books and Loe will suggest what to read next.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinda paari raamatut ja Loe soovitab, mida edasi lugeda."
          }
        }
      }
    },
    "Read next": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe edasi"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi"
          }
        }
      }
    },
    "Search by title, author or ISBN.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi pealkirja, autori või ISBN-i järgi."
          }
        }
      }
    },
    "Shelves": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiulid"
          }
        }
      }
    },
    "The catalogue can't be read": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogi ei saa lugeda"
          }
        }
      }
    },
    "The catalogue isn't here yet": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogi pole veel siin"
          }
        }
      }
    },
    "Title, author or ISBN": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pealkiri, autor või ISBN"
          }
        }
      }
    },
    "Your shelves are empty": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiulid on tühjad"
          }
        }
      }
    }
  },
  "version": "1.0"
}
