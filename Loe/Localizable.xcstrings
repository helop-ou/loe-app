      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa riiulisse"
          }
        }
      }
    },
    "Allow Loe to use the camera in Settings, or type the ISBN into Search.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba Loel seadetes kaamerat kasutada või sisesta ISBN otsingusse."
