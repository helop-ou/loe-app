    },
    "Every book published in Estonia, about 30 MB. Until it's here, Search finds only books from abroad.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik Eestis ilmunud raamatud, umbes 30 MB. Kuni see kohale jõuab, leiab otsing ainult välismaal ilmunud raamatuid."
          }
        }
      }
    },
    "Every book published in Estonia, from the National Library of Estonia, so search works offline.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõik Eestis ilmunud raamatud, Eesti Rahvusraamatukogult, et otsing töötaks ka võrguta."
          }
        }
      }
    },
