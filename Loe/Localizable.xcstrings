              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld väljaanne"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld väljaannet"
                }
              }
            }
          }
        }
      }
    },
    "%lld of 5 stars": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of 5 stars"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of 5 stars"
                }
              }
            }
          }
