    "Cover: ESTER": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaanepilt: ESTER"
          }
        }
      }
    },
    "Cover: Open Library": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaanepilt: Open Library"
          }
        }
      }
    },
    "Covers": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaaned"
          }
        }
      }
    },
    "Covers of Estonian books come from ESTER, and covers of books from abroad from Open Library and the Internet Archive. Each sees which books' covers were asked for. Loe keeps the covers on your phone.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eesti raamatute kaaned tulevad ESTERist ning välismaal ilmunud raamatute kaaned Open Libraryst ja Internet Archive'ist. Igaüks neist näeb, milliste raamatute kaasi küsiti. Loe hoiab kaasi sinu telefonis."
          }
        }
      }
    },
    "Credits": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tänuga"
