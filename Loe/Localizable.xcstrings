      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Libraryst"
          }
        }
      }
    },
    "From your tastes: %@": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinu maitse järgi: %@"
          }
        }
      }
    },
    "Give a book you've read four or five stars, or pick what you like to read in Settings, and Loe will suggest more like it.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna loetud raamatule neli või viis tärni või vali seadetes, mida sulle meeldib lugeda, ja Loe soovitab sarnaseid."
          }
        }
      }
    },
    "Historical": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajalooline"
          }
        }
      }
    },
    "Horror": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Õudus"
          }
        }
      }
    },
    "Humour": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Huumor"
          }
        }
      }
    },
    "In %@": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keeles"
          }
        }
      }
    },
    "In storage, can be ordered": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoidlas, saab tellida"
          }
        }
      }
    },
