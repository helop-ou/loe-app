    },
    "Add a cover photo": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa kaanepilt"
          }
        }
      }
    },
    "Add to shelf": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisa riiulisse"
          }
        }
      }
    },
    "Allow Loe to use the camera in Settings, or type the ISBN into Search.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Luba Loel seadetes kaamerat kasutada või sisesta ISBN otsingusse."
          }
        }
      }
    },
    "Apollo": {
      "shouldTranslate": false
    },
    "Bookshop": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Raamatupood"
          }
        }
      }
    },
    "By the same author": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Samalt autorilt"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loobu"
          }
        }
      }
    },
    "Change the cover photo": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda kaanepilti"
          }
        }
      }
    },
    "Check the spelling, or try the author's name.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli kirjapilti või proovi autori nime."
          }
        }
      }
    },
    "Check your connection and try again.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrolli ühendust ja proovi uuesti."
          }
        }
      }
    },
    "Choose a photo": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vali pilt"
          }
        }
      }
    },
    "Didn't finish": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jäi pooleli"
          }
        }
      }
    },
    "Download the catalogue": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadi kataloog alla"
          }
        }
      }
    },
    "Downloading the catalogue": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloog laaditakse alla"
          }
        }
      }
    },
    "ESTER": {
      "shouldTranslate": false
    },
    "Editions": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Väljaanded"
          }
        }
      }
    },
    "Find a book": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia raamat"
          }
        }
      }
    },
    "Find a book in Search and add it to a shelf.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi raamatut ja lisa see riiulisse."
          }
        }
      }
    },
    "In %@": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keeles"
          }
        }
      }
    },
    "It may be from a newer version of Loe.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See võib olla Loe uuemast versioonist."
          }
        }
      }
    },
    "Loe keeps every Estonian book on your phone, so search works offline. It's one download of about 30 MB.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe hoiab kõiki eesti raamatuid sinu telefonis, nii et otsing töötab ka võrguühenduseta. Selleks tuleb üks kord alla laadida umbes 30 MB."
          }
        }
      }
    },
    "No book with this ISBN": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Selle ISBN-iga raamatut pole"
          }
        }
      }
    },
    "No books found": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Raamatuid ei leitud"
          }
        }
      }
    },
    "Not rated": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindamata"
          }
        }
      }
    },
    "Not started": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pole veel alustanud"
          }
        }
      }
    },
    "Nothing to suggest yet": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Veel pole midagi soovitada"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Ava seaded"
          }
        }
      }
    },
    "Opens in your browser.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaneb brauseris."
          }
        }
      }
    },
    "Page you're on": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehekülg, kus oled"
          }
        }
      }
    },
    "Pages in the book": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lehekülgi raamatus"
          }
        }
      }
    },
    "Point the camera at the barcode on the back of the book.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Suuna kaamera raamatu tagakaanel olevale triipkoodile."
          }
        }
      }
    },
    "Rahva Raamat": {
      "shouldTranslate": false
    },
    "Rate a few books and Loe will suggest what to read next.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinda paari raamatut ja Loe soovitab, mida edasi lugeda."
          }
        }
      }
    },
    "Rating": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinne"
          }
        }
      }
    },
    "Read": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loetud"
          }
        }
      }
    },
    "Read next": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loe edasi"
          }
        }
      }
    },
    "Reading": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Loen praegu"
          }
        }
      }
    },
    "Remove from shelves": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda riiulilt"
          }
        }
      }
    },
    "Remove photo": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Eemalda pilt"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvesta"
          }
        }
      }
    },
    "Scan a barcode": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanni triipkood"
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi"
          }
        }
      }
    },
    "Search by title, author or ISBN.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Otsi pealkirja, autori või ISBN-i järgi."
          }
        }
      }
    },
    "See if your library has it": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaata, kas raamatukogus on"
          }
        }
      }
    },
    "Set aside": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kõrvale pandud"
          }
        }
      }
    },
    "Shelf: %@": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiul: %@"
          }
        }
      }
    },
    "Shelves": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiulid"
          }
        }
      }
    },
    "Show all %lld editions": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Näita kõiki %lld väljaannet"
          }
        }
      }
    },
    "Take a photo": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pildista"
          }
        }
      }
    },
    "The camera isn't available": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaamera pole kasutatav"
          }
        }
      }
    },
    "The catalogue can't be read": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogi ei saa lugeda"
          }
        }
      }
    },
    "The catalogue has the books published in Estonia. Try the title instead.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogis on Eestis ilmunud raamatud. Proovi pealkirja järgi."
          }
        }
      }
    },
    "The catalogue isn't here yet": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kataloogi pole veel siin"
          }
        }
      }
    },
    "The download didn't finish": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Allalaadimine jäi pooleli"
          }
        }
      }
    },
    "Title, author or ISBN": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Pealkiri, autor või ISBN"
          }
        }
      }
    },
    "Translated": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlge"
          }
        }
      }
    },
    "Translated by %@": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlkinud %@"
          }
        }
      }
    },
    "Translated from %@": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlgitud %@ keelest"
          }
        }
      }
    },
    "Translations": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tõlked"
          }
        }
      }
    },
    "Try again": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Proovi uuesti"
          }
        }
      }
    },
    "Update page": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muuda lehekülge"
          }
        }
      }
    },
    "Want to read": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan lugeda"
          }
        }
      }
    },
    "Where to get it": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kust saada"
          }
        }
      }
    },
    "You can keep using Loe while it downloads.": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Võid Loe kasutamist samal ajal jätkata."
          }
        }
      }
    },
    "Your shelves are empty": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Riiulid on tühjad"
          }
        }
      }
    },
    "p. %lld": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "lk %lld"
          }
        }
      }
    },
    "p. %lld of %lld": {
      "localizations": {
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "lk %1$lld / %2$lld"
          }
        }
      }
    }
  },
  "version": "1.0"
}
